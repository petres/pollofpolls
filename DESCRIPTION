Package: pollofpolls
Type: Package
Title: Load and Analyse European Poll of Polls Data
Version: 0.5.0
Authors@R: person(given = "Peter",
                  family = "Reschenhofer",
                  role = c("aut", "cre"),
                  email = "peter.reschenhofer@gmail.com")
Description: Downloads national voting intention polls published by POLITICO's
    "Poll of Polls" project and provides poll aggregation methods (Kalman
    filtering and weighted rolling means) similar to those used by the original
    pollofpolls.eu website. Polls, election results and trends are returned as
    'data.table' objects and can be visualised with a dedicated plot method.
URL: https://github.com/petres/pollofpolls
BugReports: https://github.com/petres/pollofpolls/issues
Depends:
    R (>= 4.0.0)
Imports:
    data.table,
    grDevices,
    graphics,
    jsonlite,
    stats,
    tools,
    utils
Suggests:
    KFAS,
    testthat (>= 3.2.0),
    withr
License: GPL (>= 3)
Encoding: UTF-8
